---
import Icon from './Icon.astro';
---
<a
  class="whatsapp-fab"
  href="https://wa.me/9779804831080"
  target="_blank"
  rel="noopener"
  aria-label="Chat with Madesh Media Lab on WhatsApp"
>
  <Icon name="message-circle" size={26} />
</a>

<style>
  .whatsapp-fab {
    position: fixed;
    right: var(--space-3);
    bottom: var(--space-3);
    z-index: 60;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #25d366;
    color: #ffffff;
    box-shadow: 0 12px 32px rgba(37, 211, 102, 0.4);
    transition: transform 0.25s var(--ease-out), box-shadow 0.25s var(--ease-out), background-color 0.2s ease;
  }
  .whatsapp-fab:hover {
    transform: translateY(-4px) scale(1.04);
    background: #1ebe5b;
    box-shadow: 0 16px 40px rgba(37, 211, 102, 0.5);
  }
  /* Soft attention ring — motion-safe */
  .whatsapp-fab::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid rgba(37, 211, 102, 0.55);
  }
  @media (prefers-reduced-motion: no-preference) {
    .whatsapp-fab::after {
      animation: fab-ring 2.2s ease-out infinite;
    }
    @keyframes fab-ring {
      0% { transform: scale(0.85); opacity: 1; }
      100% { transform: scale(1.25); opacity: 0; }
    }
  }
  @media (max-width: 639px) {
    .whatsapp-fab {
      right: var(--space-2);
      bottom: var(--space-2);
      width: 52px;
      height: 52px;
    }
  }
</style>
