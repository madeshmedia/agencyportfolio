---
interface Props {
  heading: string;
  sub?: string;
  buttonLabel?: string;
  buttonLink?: string;
}
const {
  heading,
  sub,
  buttonLabel = 'Get Free Consultation',
  buttonLink = '/contact',
} = Astro.props as Props;
---
<section class="cta-band section section--deep grid-bg" aria-labelledby="cta-heading">
  <div class="container cta-inner reveal">
    <p class="eyebrow">No commitment required</p>
    <h2 id="cta-heading">{heading}</h2>
    {sub && <p class="lead muted">{sub}</p>}
    <a class="btn btn--primary btn--xl" href={buttonLink} data-magnetic>{buttonLabel}</a>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    overflow: hidden;
    text-align: center;
  }
  .cta-band::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(640px 300px at 50% 115%, rgba(200, 255, 46, 0.16), transparent 70%);
    pointer-events: none;
  }
  .cta-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    max-width: 840px;
  }
  .cta-inner h2 {
    font-size: clamp(34px, 5.4vw, 68px);
  }
  .cta-inner .btn--xl {
    margin-top: var(--space-3);
    min-height: 60px;
    padding: 18px 40px;
    font-size: 15px;
  }
</style>
