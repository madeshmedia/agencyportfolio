---
import Icon from './Icon.astro';

interface Member {
  role: string;
  bio: string;
  icon: string;
  tags: string[];
  name?: string;
  photo?: string;
}
interface Props {
  member: Member;
  delay?: number;
}
const { member, delay = 0 } = Astro.props as Props;
---
<article class="card team-card reveal" style={`--reveal-delay: ${delay}ms`} data-tilt-card="7">
  {member.photo ? (
    <span class="team-photo-wrap" aria-hidden="false">
      <img
        class="team-photo"
        src={member.photo}
        alt={member.name ?? member.role}
        width="480"
        height="600"
        loading="lazy"
      />
    </span>
  ) : (
    <span class="team-avatar" aria-hidden="true"><Icon name={member.icon} size={36} /></span>
  )}
  {member.name ? (
    <div>
      <p class="team-role">{member.role}</p>
      <h3>{member.name}</h3>
    </div>
  ) : (
    <h3>{member.role}</h3>
  )}
  <p class="muted">{member.bio}</p>
  <ul class="tag-row" aria-label="Specialties">
    {member.tags.map((t) => (
      <li class="pill">{t}</li>
    ))}
  </ul>
</article>

<script>
  // 3D pointer tilt for cards (fine pointers + motion-safe only).
  // Guarded by [data-tilt-ready] so repeated component instances never
  // double-bind the same card.
  (() => {
    if (!window.matchMedia('(pointer: fine)').matches) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll('[data-tilt-card]:not([data-tilt-ready])').forEach((node) => {
      const el = node as HTMLElement;
      const max = Number(el.dataset.tiltCard || '6');
      el.dataset.tiltReady = 'true';
      el.addEventListener('mousemove', (e) => {
        const r = el.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - r.top) / r.height - 0.5;
        el.style.transition = 'transform 0.06s linear';
        el.style.transform = `perspective(900px) rotateX(${(-py * max).toFixed(2)}deg) rotateY(${(px * max).toFixed(2)}deg) translateY(-4px)`;
      });
      el.addEventListener('mouseleave', () => {
        el.style.transition = 'transform 0.5s cubic-bezier(0.22, 1, 0.36, 1)';
        el.style.transform = '';
      });
    });
  })();
</script>

<style>
  .team-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    text-align: left;
  }
  .team-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 20%, rgba(212, 162, 78, 0.28), transparent 60%),
      var(--color-accent-soft);
    border: 1px solid var(--color-border-dark);
    color: var(--color-accent);
  }
  /* Real team photo: cropped portrait with hover zoom */
  .team-photo-wrap {
    display: block;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--color-border-dark);
    aspect-ratio: 4 / 5;
    background: var(--color-bg-alt);
  }
  .team-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.6s var(--ease-out);
  }
  .team-card:hover .team-photo {
    transform: scale(1.04);
  }
  .team-card p {
    font-size: 15px;
    flex: 1;
  }
  .team-role {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent-deep); /* lime-on-white fails AA — deep lime here */
    margin: 0 0 4px;
  }
  .team-card h3 {
    margin: 0;
  }
  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
  }
</style>
