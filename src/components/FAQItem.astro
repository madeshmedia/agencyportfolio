---
interface Props {
  q: string;
  a: string;
  open?: boolean;
}
const { q, a, open = false } = Astro.props as Props;
---
<details class="card faq-item reveal" open={open || undefined}>
  <summary>
    <span>{q}</span>
    <span class="faq-chevron" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
    </span>
  </summary>
  <p class="muted">{a}</p>
</details>

<style>
  .faq-item {
    padding: 0;
  }
  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-3);
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: 18px;
    list-style: none;
    border-radius: var(--radius-card);
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-chevron {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    transition: transform 0.25s var(--ease-out);
  }
  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }
  .faq-item p {
    padding: 0 var(--space-3) var(--space-3);
  }
</style>
