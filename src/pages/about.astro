---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import TeamCard from '../components/TeamCard.astro';
import Icon from '../components/Icon.astro';
import why from '../data/why.json';
import team from '../data/team.json';

const advantages = [
  { icon: 'brain', title: 'Creative Team', body: 'Designers, editors, and strategists who turn bold ideas into polished digital experiences.' },
  { icon: 'wallet', title: 'Affordable Solutions', body: 'Premium quality without the premium agency price tag — packages built for growing budgets.' },
  { icon: 'message-circle', title: 'Fast Communication', body: 'Quick replies, clear updates, and zero ghosting. You always know where your project stands.' },
  { icon: 'rocket', title: 'Modern Strategy', body: "Up-to-date tactics that work with today's algorithms — not last year's playbook." },
  { icon: 'target', title: 'Results-Driven Approach', body: "We measure everything. If it doesn't move your business forward, we don't do it — simple as that." },
];

const teamTeaser = team.slice(0, 3);
---
<BaseLayout
  title="About Madesh Media Lab — Our Story, Mission & Values"
  description="Learn how Madesh Media Lab became a trusted digital growth partner for local and international brands."
  path="/about"
>
  <section class="page-hero" aria-labelledby="about-heading">
    <div class="container">
      <p class="eyebrow reveal">About Us</p>
      <h1 id="about-heading" class="reveal" style="--reveal-delay: 80ms">Our story</h1>
      <p class="lead reveal" style="--reveal-delay: 160ms">
        Madesh Media Lab was created with a vision to help businesses succeed
        in the digital world. We saw local businesses with incredible products
        struggling to reach their audience online — and we knew we could change
        that.
      </p>
    </div>
  </section>

  <section class="section section--white" aria-label="Story continued">
    <div class="container narrow reveal">
      <p class="lead">
        Today, our team blends strategy, creativity, and technology to help
        brands build authority, attract customers, and grow online. We treat
        every project like it's our own business.
      </p>
    </div>
  </section>

  <section class="section section--light" aria-labelledby="mission-heading">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">What Drives Us</p>
        <h2 id="mission-heading">Mission &amp; vision</h2>
      </div>
      <div class="grid grid-2">
        <article class="card mission-card reveal">
          <span class="icon-tile"><Icon name="target" size={24} /></span>
          <h3>Mission</h3>
          <p class="muted">Help local and international businesses build a strong online presence and achieve measurable, sustainable growth.</p>
        </article>
        <article class="card mission-card reveal" style="--reveal-delay: 70ms">
          <span class="icon-tile"><Icon name="rocket" size={24} /></span>
          <h3>Vision</h3>
          <p class="muted">To be the most trusted digital growth partner for emerging brands worldwide.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--dark" aria-labelledby="why-full-heading">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Why Us</p>
        <h2 id="why-full-heading">Why choose Madesh Media Lab</h2>
      </div>
      <div class="grid grid-2">
        {why.map((item, i) => (
          <article class="card why-card reveal" style={`--reveal-delay: ${(i % 2) * 70}ms`}>
            <span class="icon-tile"><Icon name={item.icon} size={24} /></span>
            <div>
              <h3>{item.title}</h3>
              <p class="muted">{item.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="advantage-heading">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">The Advantage</p>
        <h2 id="advantage-heading">Five reasons brands pick us</h2>
      </div>
      <ol class="advantage-list">
        {advantages.map((a, i) => (
          <li class="card reveal" style={`--reveal-delay: ${(i % 3) * 70}ms`}>
            <span class="adv-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="icon-tile"><Icon name={a.icon} size={24} /></span>
            <div>
              <h3>{a.title}</h3>
              <p class="muted">{a.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--light" aria-labelledby="team-teaser-heading">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">The Team</p>
        <h2 id="team-teaser-heading">Young founders, serious craft</h2>
        <p class="lead muted">Young entrepreneurs passionate about technology, business, and digital growth.</p>
      </div>
      <div class="grid grid-3">
        {teamTeaser.map((m, i) => (
          <TeamCard member={m} delay={(i % 3) * 70} />
        ))}
      </div>
      <p class="center-cta reveal">
        <a class="text-link" href="/team">
          Meet the full team <Icon name="arrow-right" size={16} />
        </a>
      </p>
    </div>
  </section>

  <CTASection
    heading="Ready to grow your brand online?"
    sub="Book a free consultation and get a custom growth plan for your business — no commitment required."
    buttonLabel="Get Free Consultation"
    buttonLink="/contact"
  />
</BaseLayout>

<style>
  .narrow {
    max-width: 800px;
  }
  .narrow .lead {
    margin: 0;
  }
  .mission-card {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .why-card {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-4);
    align-items: flex-start;
  }
  .why-card p,
  .advantage-list p {
    margin: 8px 0 0;
    font-size: 15px;
  }
  .advantage-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .advantage-list li {
    position: relative;
    display: flex;
    gap: var(--space-2);
    padding: var(--space-4);
    align-items: flex-start;
  }
  .advantage-list li:first-child {
    grid-column: 1 / -1;
  }
  .adv-num {
    position: absolute;
    top: var(--space-2);
    right: var(--space-3);
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: 15px;
    color: var(--color-accent);
    opacity: 0.85;
  }
  .center-cta {
    text-align: center;
    margin-top: var(--space-6);
    margin-bottom: 0;
  }
  @media (max-width: 639px) {
    .advantage-list {
      grid-template-columns: 1fr;
    }
  }
</style>
