---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import Icon from '../components/Icon.astro';
import steps from '../data/process.json';
---
<BaseLayout
  title="How We Work — Our Process | Madesh Media Lab"
  description="A simple, transparent 5-step process — from discovery to ongoing growth — for every Madesh Media Lab project."
  path="/process"
>
  <section class="page-hero" aria-labelledby="process-heading">
    <div class="container">
      <p class="eyebrow reveal">How We Work</p>
      <h1 id="process-heading" class="reveal" style="--reveal-delay: 80ms">A simple 5-step process</h1>
      <p class="lead reveal" style="--reveal-delay: 160ms">
        No mystery, no jargon. Just a clear path from idea to ongoing growth.
      </p>
    </div>
  </section>

  <section class="section section--white" aria-label="Process timeline">
    <div class="container">
      <ol class="timeline">
        {steps.map((s, i) => (
          <li class="reveal" style={`--reveal-delay: ${i * 60}ms`}>
            <span class="timeline-dot" aria-hidden="true">
              <span class="icon-tile"><Icon name={s.icon} size={24} /></span>
              <span class="timeline-num">{String(i + 1).padStart(2, '0')}</span>
            </span>
            <article class="card timeline-card">
              <h2>{s.title}</h2>
              <p class="muted">{s.body}</p>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CTASection
    heading="Ready to start the process?"
    buttonLabel="Get Free Consultation"
    buttonLink="/contact"
  />
</BaseLayout>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 760px;
    margin-inline: auto;
    position: relative;
  }
  .timeline::before {
    content: '';
    position: absolute;
    top: var(--space-2);
    bottom: var(--space-2);
    left: 31px;
    width: 2px;
    background: var(--color-border);
  }
  .timeline li {
    position: relative;
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: var(--space-3);
    align-items: start;
  }
  .timeline-dot {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    z-index: 1;
  }
  .timeline-num {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: 13px;
    letter-spacing: var(--tracking-label);
    color: var(--color-accent);
    background: var(--color-surface-white);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
  }
  .timeline-card {
    padding: var(--space-4);
  }
  .timeline-card h2 {
    font-size: var(--text-h3-desktop);
    margin-bottom: 8px;
  }
  .timeline-card p {
    margin: 0;
  }
  @media (min-width: 1024px) {
    .timeline {
      max-width: none;
    }
    .timeline::before {
      left: 0;
      right: 0;
      top: 31px;
      bottom: auto;
      width: auto;
      height: 2px;
    }
    .timeline {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: var(--space-2);
    }
    .timeline li {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
  @media (max-width: 639px) {
    .timeline-card h2 {
      font-size: var(--text-h3-mobile);
    }
  }
</style>
