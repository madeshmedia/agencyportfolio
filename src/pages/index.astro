---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import ServiceCard from '../components/ServiceCard.astro';
import PortfolioCard from '../components/PortfolioCard.astro';
import HeroVisual from '../components/HeroVisual.astro';
import MessageForm from '../components/MessageForm.astro';
import Icon from '../components/Icon.astro';
import services from '../data/services.json';
import portfolio from '../data/portfolio.json';
import why from '../data/why.json';
import steps from '../data/process.json';

const previewServices = services.slice(0, 6);
const featuredWork = portfolio.slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Madesh Media Lab',
  slogan: 'From Vision to Digital Reality',
  description:
    'Madesh Media Lab helps local and international businesses grow online with social media management, content, Meta ads, web design, and branding.',
  areaServed: 'Nepal',
  email: 'madeshmedialab@gmail.com',
  telephone: '+977 9804831080',
  url: 'https://madeshmedialab.vercel.app/',
  sameAs: [
    'https://www.instagram.com/madesh_media_lab',
    'https://www.facebook.com/share/1DvmvuGkbj/',
  ],
};
---
<BaseLayout
  title="Madesh Media Lab — Digital Marketing Agency in Nepal | From Vision to Digital Reality"
  description="Madesh Media Lab helps local and international businesses grow online with social media management, content, Meta ads, web design, and branding."
  path="/"
  jsonLd={jsonLd}
>
  <!-- Hero (deep lab canvas) -->
  <section class="hero section--deep grid-bg" aria-labelledby="hero-heading">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-grid" data-hero-parallax>
      <div class="hero-copy">
        <p class="hero-badge hero-anim">
          <span class="live-dot"></span> Digital Marketing Agency — Nepal
        </p>
        <h1 id="hero-heading" class="hero-anim" style="animation-delay: 80ms">
          From vision<br />to <span class="text-outline">digital</span> reality<span class="lime-dot">.</span>
        </h1>
        <p class="lead muted hero-anim" style="animation-delay: 160ms">
          Madesh Media Lab combines strategy, creativity, and technology to
          help brands build authority, attract customers, and grow online.
          Your digital growth partner — from first idea to measurable results.
        </p>
        <div class="hero-ctas hero-anim" style="animation-delay: 240ms">
          <a class="btn btn--primary" href="/contact" data-magnetic>Get Free Consultation</a>
          <a class="btn btn--secondary" href="/portfolio" data-magnetic>View Our Work</a>
        </div>
        <dl class="hero-stats hero-anim" style="animation-delay: 320ms">
          <!-- NOTE: original "0+ Projects / 0% Focus" placeholders removed per content flag.
               These three figures are grounded in this site's own content (7 services,
               5-step process, 24-hour contact reply promise) until client supplies real stats. -->
          <div>
            <dt>Core services</dt>
            <dd><span data-count="7">0</span></dd>
          </div>
          <div>
            <dt>Step process</dt>
            <dd><span data-count="5">0</span></dd>
          </div>
          <div>
            <dt>Reply within</dt>
            <dd>24h</dd>
          </div>
        </dl>
      </div>
      <div class="hero-art hero-anim" style="animation-delay: 200ms">
        <HeroVisual />
      </div>
    </div>
    <a class="scroll-cue hero-anim" style="animation-delay: 560ms" href="#about" aria-label="Scroll to content">
      <span aria-hidden="true"></span>
    </a>
    <div class="marquee hero-marquee" aria-hidden="true">
      <div class="marquee-track">
        <span>Social Media</span><i>✦</i><span>Content Creation</span><i>✦</i><span>Reels &amp; Video</span><i>✦</i><span>Meta Ads</span><i>✦</i><span>Web Design</span><i>✦</i><span>Branding</span><i>✦</i><span>Strategy</span><i>✦</i>
        <span>Social Media</span><i>✦</i><span>Content Creation</span><i>✦</i><span>Reels &amp; Video</span><i>✦</i><span>Meta Ads</span><i>✦</i><span>Web Design</span><i>✦</i><span>Branding</span><i>✦</i><span>Strategy</span><i>✦</i>
      </div>
    </div>
  </section>

  <!-- About teaser (white) -->
  <section class="section section--white" id="about" aria-labelledby="about-teaser-heading">
    <div class="container teaser-grid">
      <div class="reveal">
        <p class="eyebrow">About Us</p>
        <h2 id="about-teaser-heading">Helping businesses win online</h2>
      </div>
      <div class="reveal" style="--reveal-delay: 80ms">
        <p class="lead muted">
          What started as a passion for technology, marketing, and creativity
          evolved into a dedicated team providing digital solutions for
          ambitious brands.
        </p>
        <a class="text-link" href="/about">
          Learn our story <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </section>

  <!-- Services preview (light) -->
  <section class="section section--light" aria-labelledby="services-heading">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">What We Do</p>
        <h2 id="services-heading">Services built for real growth</h2>
        <p class="lead muted">
          Seven core services covering everything your brand needs to dominate
          the digital space.
        </p>
      </div>
      <div class="grid grid-3">
        {previewServices.map((s, i) => (
          <ServiceCard service={s} delay={(i % 3) * 70} />
        ))}
      </div>
      <p class="center-cta reveal">
        <a class="btn btn--secondary" href="/services">View All Services</a>
      </p>
    </div>
  </section>

  <!-- Why choose us (dark) -->
  <section class="section section--dark" aria-labelledby="why-heading">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Why Choose Us</p>
        <h2 id="why-heading">A partner built for momentum</h2>
      </div>
      <div class="grid grid-2">
        {why.map((item, i) => (
          <article class="card why-card reveal" style={`--reveal-delay: ${(i % 2) * 70}ms`}>
            <span class="icon-tile"><Icon name={item.icon} size={24} /></span>
            <div>
              <h3>{item.title}</h3>
              <p class="muted">{item.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured work (light) -->
  <section class="section section--light" aria-labelledby="work-heading">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Our Work</p>
        <h2 id="work-heading">Featured projects</h2>
      </div>
      <div class="grid grid-3">
        {featuredWork.map((p, i) => (
          <PortfolioCard project={p} delay={(i % 3) * 70} />
        ))}
      </div>
      <p class="center-cta reveal">
        <a class="btn btn--secondary" href="/portfolio">View Full Portfolio</a>
      </p>
    </div>
  </section>

  <!-- Process teaser (dark) -->
  <section class="section section--dark-alt" aria-labelledby="process-teaser-heading">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <p class="eyebrow">How We Work</p>
        <h2 id="process-teaser-heading">A simple 5-step process</h2>
      </div>
      <ol class="steps-strip">
        {steps.map((s, i) => (
          <li class="reveal" style={`--reveal-delay: ${i * 70}ms`}>
            <span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="step-name">{s.title}</span>
          </li>
        ))}
      </ol>
      <p class="center-cta reveal">
        <a class="text-link" href="/process">
          See the full process <Icon name="arrow-right" size={16} />
        </a>
      </p>
    </div>
  </section>

  <CTASection
    heading="Ready to grow your brand online?"
    sub="Book a free consultation and get a custom growth plan for your business — no commitment required."
    buttonLabel="Get Free Consultation"
    buttonLink="/contact"
  />

  <!-- Message form (white) -->
  <section class="section section--white" id="message" aria-labelledby="message-heading">
    <div class="container message-grid">
      <div class="reveal">
        <p class="eyebrow">Send a Message</p>
        <h2 id="message-heading">Tell us about your project</h2>
        <p class="lead muted">
          Drop your details and a line about what you need — your message is
          saved securely and we'll reply with a custom plan.
        </p>
        <ul class="message-direct">
          <li>
            <a href="https://wa.me/9779804831080" target="_blank" rel="noopener">
              <span class="icon-tile"><Icon name="message-circle" size={24} /></span>
              <span>
                <strong>Chat on WhatsApp</strong>
                <span class="muted">+977 9804831080</span>
              </span>
            </a>
          </li>
          <li>
            <a href="mailto:madeshmedialab@gmail.com">
              <span class="icon-tile"><Icon name="mail" size={24} /></span>
              <span>
                <strong>Email Us</strong>
                <span class="muted">madeshmedialab@gmail.com</span>
              </span>
            </a>
          </li>
        </ul>
      </div>
      <div class="reveal" style="--reveal-delay: 100ms">
        <MessageForm />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Gentle hero parallax on scroll (disabled when motion is reduced)
  const heroGrid = document.querySelector('[data-hero-parallax]');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (heroGrid && !calm) {
    let ticking = false;
    const update = () => {
      const range = Math.min(window.scrollY / 600, 1);
      (heroGrid as HTMLElement).style.transform = `translateY(${(range * 60).toFixed(1)}px)`;
      (heroGrid as HTMLElement).style.opacity = String(1 - range * 0.55);
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking && window.scrollY < 700) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: calc(76px + var(--space-12));
    padding-bottom: 0;
  }
  .hero-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(760px 420px at 88% 4%, rgba(62, 198, 224, 0.13), transparent 65%),
      radial-gradient(880px 480px at 4% 108%, rgba(200, 255, 46, 0.14), transparent 65%),
      radial-gradient(560px 380px at 52% 42%, rgba(139, 124, 255, 0.1), transparent 70%);
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: var(--space-8);
    align-items: center;
    padding-bottom: var(--space-8);
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent);
    padding: 9px 18px;
    border: 1px solid rgba(200, 255, 46, 0.35);
    border-radius: var(--radius-pill);
    background: rgba(200, 255, 46, 0.06);
    margin-bottom: var(--space-3);
  }
  .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    flex: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .live-dot {
      animation: pulse 1.6s ease-in-out infinite;
    }
    @keyframes pulse {
      50% { opacity: 0.35; transform: scale(0.8); }
    }
  }
  .hero h1 {
    margin-bottom: var(--space-3);
  }
  .lime-dot {
    color: var(--color-accent);
  }
  .hero .lead {
    max-width: 52ch;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-anim {
      opacity: 0;
      transform: translateY(22px);
      animation: hero-in 0.8s var(--ease-out) forwards;
    }
    @keyframes hero-in {
      to { opacity: 1; transform: none; }
    }
  }
  .hero-stats {
    display: flex;
    gap: var(--space-6);
    margin-top: var(--space-6);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border-dark);
  }
  .hero-stats div {
    display: flex;
    flex-direction: column-reverse;
    gap: 4px;
  }
  .hero-stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 44px;
    font-weight: var(--weight-bold);
    line-height: 1.05;
    color: var(--color-text-inverse);
  }
  .hero-stats dd span {
    color: var(--color-accent);
  }
  .hero-stats dd:last-child {
    color: var(--color-accent);
  }
  .hero-stats dt {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-text-muted-dark);
  }
  .hero-marquee {
    position: relative;
    border-top: 1px solid var(--color-border-dark);
    padding-block: var(--space-2);
  }  .hero-marquee .marquee-track span {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.02em;
    color: var(--color-text-inverse);
    opacity: 0.9;
    text-transform: uppercase;
  }
  .hero-marquee .marquee-track i {
    font-style: normal;
    color: var(--color-accent);
    font-size: 16px;
  }
  /* Scroll cue — animated wheel, static outline when motion is reduced */
  .scroll-cue {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    padding-bottom: var(--space-3);
    text-decoration: none;
  }
  .scroll-cue span {
    position: relative;
    width: 26px;
    height: 42px;
    border: 1.5px solid rgba(242, 245, 236, 0.4);
    border-radius: 999px;
  }
  .scroll-cue span::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 8px;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    border-radius: 4px;
    background: var(--color-accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .scroll-cue span::after {
      animation: cue-drop 1.8s ease-in-out infinite;
    }
    @keyframes cue-drop {
      0% { transform: translateY(0); opacity: 1; }
      70% { transform: translateY(14px); opacity: 0; }
      100% { transform: translateY(0); opacity: 0; }
    }
  }
  .teaser-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--space-6);
    align-items: start;
  }
  /* Homepage message section */
  .message-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: var(--space-6);
    align-items: start;
  }
  .message-grid h2 {
    margin-bottom: var(--space-2);
  }
  .message-direct {
    list-style: none;
    padding: 0;
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .message-direct a {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    text-decoration: none;
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface-white);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .message-direct a:hover {
    border-color: var(--color-accent-deep);
    background-color: var(--color-accent-soft);
  }
  .message-direct a > span:last-child {
    display: flex;
    flex-direction: column;
    gap: 2px;
    overflow-wrap: anywhere;
  }
  .center-cta {
    text-align: center;
    margin-top: var(--space-6);
    margin-bottom: 0;
  }
  .why-card {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-4);
    align-items: flex-start;
  }
  .why-card p {
    margin: 8px 0 0;
    font-size: 15px;
  }
  .steps-strip {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-2);
    counter-reset: step;
  }
  .steps-strip li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: var(--space-3);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-card);
    background: var(--color-bg);
  }
  .step-num {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: var(--weight-bold);
    color: var(--color-accent);
  }
  .step-name {
    font-weight: var(--weight-medium);
  }
  @media (max-width: 1023px) {
    .steps-strip {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 1023px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .message-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 639px) {
    .hero {
      padding-top: calc(76px + var(--space-8));
    }
    .hero-marquee .marquee-track span {
      font-size: 16px;
    }
    .teaser-grid {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    .hero-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-2);
    }
    .hero-stats dd {
      font-size: 28px;
    }
    .hero-stats dt {
      font-size: 10px;
      letter-spacing: 0.1em;
    }
    .steps-strip {
      grid-template-columns: 1fr;
    }
  }
</style>
